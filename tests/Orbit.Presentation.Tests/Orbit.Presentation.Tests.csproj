<!-- Tests presentation geometry and projections with no browser or audio device. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" PrivateAssets="all" />
    <ProjectReference Include="../../src/Orbit.Presentation/Orbit.Presentation.csproj" />
    <ProjectReference Include="../../tools/agent-kit/exporter/Orbit.AgentKit.Exporter.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../docs/examples/foundations/breathing-harmonic-drone/reference.orbit2.json"
          Link="Foundations/breathing-harmonic-drone/reference.orbit2.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
