<!-- Standalone Blazor WebAssembly client: compiled UI code runs in the browser. -->
<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Fingerprint the Blazor bootstrap and boot resources to prevent mixed deployments. -->
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>
  <ItemGroup>
    <!-- Browser runtime and local development server; neither is application logic. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />

    <!-- One-way dependency: the UI consumes contracts from the application library. -->
    <ProjectReference Include="../Orbit.Application/Orbit.Application.csproj" />
    <!-- Presentation geometry and state can be tested without Blazor. -->
    <ProjectReference Include="../Orbit.Presentation/Orbit.Presentation.csproj" />
    <!-- The composition root wires browser infrastructure; Razor components use only contracts. -->
    <ProjectReference Include="../Orbit.Infrastructure/Orbit.Infrastructure.csproj" />
  </ItemGroup>
</Project>
