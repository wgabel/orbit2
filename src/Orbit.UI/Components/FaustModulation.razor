@namespace Orbit.UI.Components
@using Microsoft.AspNetCore.Components.Web
@using Orbit.Application.Models

@* Presentation only. Settings are applied to a validated domain graph by the
   application service, and the Faust worklet computes modulation at audio rate. *@
<section class="audio-experiment">
    <p class="eyebrow">Experiment 03 / Signal graph</p>
    <h2>Frequency modulation</h2>
    <p>A sine LFO changes the frequency of an audible sine oscillator.</p>
    <fieldset disabled="@(!IsReady || IsPlaying)">
        <label for="modulation-base">Base frequency (Hz)</label>
        <input id="modulation-base" type="number"
               min="@ModulationDemoSettings.MinimumBaseFrequency"
               max="@ModulationDemoSettings.MaximumBaseFrequency" step="1" @bind="BaseFrequency" />
        <label for="modulation-rate">LFO frequency (Hz)</label>
        <input id="modulation-rate" type="number"
               min="@ModulationDemoSettings.MinimumLfoFrequency"
               max="@ModulationDemoSettings.MaximumLfoFrequency" step="0.05" @bind="LfoFrequency" />
        <label for="modulation-depth">Modulation depth (Hz)</label>
        <input id="modulation-depth" type="number" min="0"
               max="@ModulationDemoSettings.MaximumDepth" step="1" @bind="Depth" />
    </fieldset>
    <div class="audio-controls">
        <button type="button" @onclick="PlayAsync" disabled="@(!IsReady || IsPlaying)">
            @(IsPlaying ? "Playing…" : "Start modulation")
        </button>
        <button type="button" @onclick="StopAsync" disabled="@(!IsPlaying || IsStopping)">Stop</button>
    </div>
    <div class="clock-panel">
        <button type="button" class="secondary" @onclick="ReadClockAsync" disabled="@(!IsReady)">
            Read audio clock
        </button>
        <p role="status">@ClockDescription</p>
    </div>
    @if (ErrorMessage is not null)
    {
        <p role="alert">@ErrorMessage</p>
    }
</section>
