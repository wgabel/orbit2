@namespace Orbit.UI.Components
@using Microsoft.AspNetCore.Components.Web
@using Orbit.Application.Models
@using Orbit.UI.Components.Parameters

@* Presentation only. Settings are applied to a validated domain graph by the
   application service, and the Faust worklet computes modulation at audio rate. *@
<section class="modulation-panel">
    <h2>Frequency modulation</h2>
    <p>A sine LFO changes the frequency of an audible sine oscillator.</p>
    <fieldset disabled="@(!IsReady || IsPlaying)">
        <ParameterSlider Definition="@ModulationDemoSettings.BaseFrequencyDefinition"
                         @bind-Value="BaseFrequency" Step="1"
                         ModulationRange="@CurrentSettings.FrequencyModulationRange" EffectiveValue="@EffectiveFrequency"
                         ValidationChanged="OnParameterValidation" />
        <ParameterSlider Definition="@ModulationDemoSettings.LfoFrequencyDefinition"
                         @bind-Value="LfoFrequency" Step="0.01" ValidationChanged="OnParameterValidation" />
        <ParameterSlider Definition="@ModulationDemoSettings.DepthDefinition"
                         @bind-Value="Depth" Step="1" ValidationChanged="OnParameterValidation" />
    </fieldset>
    <div class="audio-controls">
        <button type="button" @onclick="PlayAsync" disabled="@(!IsReady || IsPlaying || InvalidParameters.Count > 0)">
            @(IsPlaying ? "Playing…" : "Start modulation")
        </button>
        <button type="button" @onclick="StopAsync" disabled="@(!IsPlaying || IsStopping)">Stop</button>
    </div>
    <div class="clock-panel">
        <button type="button" class="secondary" @onclick="ReadClockAsync" disabled="@(!IsReady)">
            Read audio clock
        </button>
        <p role="status">@ClockDescription</p>
    </div>
    @if (!IsReady && ErrorMessage is null)
    {
        <p role="status">Loading audio engine…</p>
    }
    @if (TelemetryError is not null)
    {
        <p role="status">@TelemetryError</p>
    }
    @if (ErrorMessage is not null)
    {
        <p role="alert">@ErrorMessage</p>
    }
</section>
