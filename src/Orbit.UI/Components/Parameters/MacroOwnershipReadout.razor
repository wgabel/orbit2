@namespace Orbit.UI.Components.Parameters
@using Microsoft.AspNetCore.Components
@using Orbit.Presentation.Canvas
@using System.Globalization

<div class="macro-ownership-readout" data-macro-parameter="@Ownership.Address.ParameterId" data-macro-active="@(Ownership.IsActive ? "true" : "false")"
     role="group" aria-label="@($"Macro ownership for {Ownership.ParameterName}")">
    <strong>@Ownership.ParameterName · @Ownership.MacroName</strong>
    <span>Manual: @Format(Ownership.ManualBase)</span>
    <span>Mapped: @Format(Ownership.MappedBase)</span>
    @if (Ownership.IsActive)
    {
        <span>Macro controls base; manual value is retained.</span>
    }
    else
    {
        <span>Dormant · manual base retained until active.</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public MacroOwnership Ownership { get; set; } = default!;
    private string Format(double value) => $"{value.ToString("G", CultureInfo.InvariantCulture)} {ParameterUnitLabel.Format(Ownership.Unit)}";
}
