@namespace Orbit.UI.Components.Parameters
@using Microsoft.AspNetCore.Components.Web

@* Shared parameter editor: the numeric input and range edit the base value.
   The passive band and marker display modulation without writing to the model. *@
<div class="parameter-slider">
    <div class="parameter-heading">
        <label for="@InputId">@Definition.Name <span class="parameter-unit">(@UnitLabel)</span></label>
        <input id="@InputId" type="number" min="@Format(Definition.Minimum)"
               max="@Format(Definition.Maximum)" step="any"
               value="@Draft" @oninput="EditNumberAsync" aria-invalid="@(Error is not null ? "true" : "false")"
               aria-describedby="@($"{DescriptionId} {ErrorId}")" />
    </div>
    <ValidationMessage Message="@Error" MessageId="@ErrorId" />
    <div class="parameter-track">
        <div class="parameter-rail" aria-hidden="true">
            @if (ModulationRange is { } range)
            {
                <span class="parameter-band" style="@BandStyle(range)"></span>
            }
            @if (EffectiveValue is double effective && double.IsFinite(effective))
            {
                <span class="parameter-effective-marker" style="@MarkerStyle(effective)"></span>
            }
        </div>
        <input type="range" min="@Format(RangeMinimum)" max="@Format(RangeMaximum)"
               step="@Format(RangeStep)" value="@Format(RangeValue)" @oninput="EditRangeAsync"
               @onpointerdown="BeginPointer" @onpointerup="EndPointerAsync" @onpointercancel="EndPointerAsync"
               @onlostpointercapture="EndPointerAsync" @onchange="EndPointerAsync" @onblur="EndGestureAsync"
               @onkeydown="BeginKeyboard" @onkeyup="EndKeyboard"
               aria-label="@Definition.Name" aria-valuetext="@($"{Format(Value)} {UnitLabel}")" aria-describedby="@DescriptionId" />
    </div>
    @if (Definition.DisplayScale is { } display)
    {
        <div id="@DescriptionId" class="parameter-details parameter-scale-details">
            <span>@TickLabel(Definition.Minimum)</span>
            @foreach (var anchor in display.Anchors.Skip(1).SkipLast(1))
            {
                <span class="parameter-scale-tick" style="@($"left:{FormatLive(Position(anchor.Value))}%")">@TickLabel(anchor.Value)</span>
            }
            <span>@TickLabel(Definition.Maximum)</span>
        </div>
    }
    else
    {
        <div id="@DescriptionId" class="parameter-details">
            <span>@Format(Definition.Minimum) @UnitLabel</span>
            <span>@Format(Definition.Maximum) @UnitLabel</span>
        </div>
    }
    @if (IsModulated || ModulationRange.HasValue)
    {
        <div class="parameter-modulation">
            <div class="parameter-modulation-reading">
                <span>Modulation</span>
                <output aria-label="Predicted modulation range" aria-live="off" title="@PredictedRangeText">@PredictedRangeText</output>
            </div>
            <div class="parameter-modulation-reading">
                <span>Live</span>
                <output aria-label="Live effective value" aria-live="off" title="@EffectiveValueText">@EffectiveValueText</output>
            </div>
        </div>
    }
    @if (Timing is { } timing)
    {
        <CycleTimingReadout Timing="@timing" LiveHertz="@EffectiveValue" ShowLive="@(IsModulated || ModulationRange.HasValue)"
                            MinSeconds="@(1 / Math.Clamp(Definition.Maximum * timing.BaseRatio, Definition.Minimum, Definition.Maximum))"
                            MaxSeconds="@(1 / Math.Clamp(Definition.Minimum * timing.BaseRatio, Definition.Minimum, Definition.Maximum))" HertzChanged="EditHertzAsync" />
    }
</div>
