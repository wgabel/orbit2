@namespace Orbit.UI.Components.Parameters
@using Microsoft.AspNetCore.Components.Web

@* Shared parameter editor: the numeric input and range edit the base value.
   The passive band and marker display modulation without writing to the model. *@
<div class="parameter-slider">
    <div class="parameter-heading">
        <label for="@InputId">@Definition.Name <span class="parameter-unit">(@UnitLabel)</span></label>
        <input id="@InputId" type="number" min="@Format(Definition.Minimum)"
               max="@Format(Definition.Maximum)" step="any"
               value="@Draft" @oninput="EditAsync" aria-invalid="@(Error is not null ? "true" : "false")"
               aria-describedby="@($"{DescriptionId} {ErrorId}")" />
    </div>
    <ValidationMessage Message="@Error" MessageId="@ErrorId" />
    <div class="parameter-track">
        <div class="parameter-rail" aria-hidden="true">
            @if (ModulationRange is { } range)
            {
                <span class="parameter-band" style="@BandStyle(range)"></span>
            }
            @if (EffectiveValue is double effective && double.IsFinite(effective))
            {
                <span class="parameter-effective-marker" style="@MarkerStyle(effective)"></span>
            }
        </div>
        <input type="range" min="@Format(Definition.Minimum)" max="@Format(Definition.Maximum)"
               step="@Format(Step)" value="@Format(Value)" @oninput="EditAsync"
               aria-label="@Definition.Name" aria-describedby="@DescriptionId" />
    </div>
    <div id="@DescriptionId" class="parameter-details">
        <span>@Format(Definition.Minimum) @UnitLabel</span>
        <span>@Format(Definition.Maximum) @UnitLabel</span>
    </div>
    @if (ModulationRange is { } bounds)
    {
        <div class="parameter-modulation">
            <span>Modulation: @Format(bounds.Minimum)–@Format(bounds.Maximum) @UnitLabel</span>
            @if (EffectiveValue is double current && double.IsFinite(current))
            {
                <span>Live: @FormatLive(current) @UnitLabel</span>
            }
        </div>
    }
</div>
