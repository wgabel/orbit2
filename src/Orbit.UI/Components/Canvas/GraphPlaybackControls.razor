@namespace Orbit.UI.Components.Canvas
@using Microsoft.AspNetCore.Components.Web

@* Reusable controls for a graph snapshot. Audio execution belongs to the service. *@
<div class="workspace-toolbar">
    <button type="button" @onclick="PlayAsync" disabled="@(!IsReady || IsActive)">Play patch</button>
    <button type="button" class="secondary" @onclick="StopAsync" disabled="@(!IsActive || IsStopping)">Stop</button>
    <span class="workspace-notice" role="status">@Status</span>
</div>
@if (Error is not null)
{
    <p class="parameter-error workspace-error" role="alert">@Error</p>
}
