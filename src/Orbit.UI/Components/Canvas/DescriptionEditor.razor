@namespace Orbit.UI.Components.Canvas
@using Orbit.Application.Persistence
@using Microsoft.AspNetCore.Components.Web

<section class="note-editor description-editor" role="region" aria-label="Edit canvas description"
         @onpointerdown:stopPropagation="true" @onwheel:stopPropagation="true"
         @onkeydown="HandleKey" @onkeydown:stopPropagation="true">
    <strong>@Heading</strong>
    <label>@(IsConnection ? "Connection label" : "Alias")
        <input @ref="nameInput" maxlength="@DescriptionLimits.NameLength" @bind="name" @bind:event="oninput" />
    </label>
    @if (!IsConnection)
    {
        <label>Description <textarea maxlength="@DescriptionLimits.BodyLength" @bind="body" @bind:event="oninput"></textarea></label>
    }
    <p class="workspace-notice">Presentation only. Empty fields remove the corresponding description.</p>
    <div class="note-actions">
        <button type="button" @onclick="Apply">Apply</button>
        <button type="button" class="secondary" @onclick="OnCancel">Cancel</button>
    </div>
</section>

@code {
    [Parameter] public string Heading { get; set; } = "";
    [Parameter] public bool IsConnection { get; set; }
    [Parameter] public string InitialName { get; set; } = "";
    [Parameter] public string InitialBody { get; set; } = "";
    [Parameter] public EventCallback<(string Name, string Body)> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private string name = "";
    private string body = "";
    private ElementReference nameInput;

    protected override void OnInitialized() { name = InitialName; body = InitialBody; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await nameInput.FocusAsync(preventScroll: true);
    }
    private Task Apply() => OnApply.InvokeAsync((name, body));
    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" ? OnCancel.InvokeAsync() : Task.CompletedTask;
}
