@namespace Orbit.UI.Components.Canvas
@using Microsoft.AspNetCore.Components.Web
@using Orbit.Presentation.Canvas
@using Orbit.Domain.Nodes.Composites

@* Root and nested editors use the same canvas, with no dependencies on the DSP runtime. *@
@{ var wires = Wires; }
<div class="graph-canvas">
    <div class="canvas-viewport" @ref="viewportElement" tabindex="0" aria-label="Graph canvas"
         aria-keyshortcuts="F 0 Shift+F10" data-fit-sequence="@fitSequence" data-pinching="@(pinchOrigin is not null ? "true" : "false")"
         @onpointerdown="BeginBackground" @onpointerdown:preventDefault="true"
         @onpointermove="PointerMoved" @onpointerup="PointerReleasedAsync"
         @onpointercancel="CancelGesture" @onpointerleave="CancelGesture" @onlostpointercapture="CancelGesture"
         @onwheel="OnWheelAsync" @onwheel:preventDefault="true" @onkeydown="KeyDown">
        <div class="canvas-world" style="@WorldStyle">
            @foreach (var group in Snapshot.VisualGroups.Where(group => Snapshot.GroupDetail(group.Id) != AnnotationDetail.Hidden))
            {
                <VisualGroupFrame @key="group.Id" Group="@(groupPreview?.Id == group.Id ? groupPreview : group)"
                                  Selected="@(Snapshot.SelectedGroupId == group.Id)" Locked="@(HasAnnotationDraft || AnnotationActionsDisabled)"
                                  Detail="@Snapshot.GroupDetail(group.Id)" Zoom="@Snapshot.Viewport.Zoom" OnReveal="@(() => SelectAnnotationAsync(group.Id, true))"
                                  OnSelect="@(() => { State.SelectGroup(group.Id); })"
                                  OnMove="@(args => BeginGroupAsync(group, args, false))" OnResize="@(args => BeginGroupAsync(group, args, true))"
                                  OnEdit="@(() => BeginGroupEditAsync(group))" OnDelete="@(() => NoteAction(() => State.DeleteGroup(group.Id)))"
                                  OnUpdate="@(updated => NoteAction(() => State.UpdateGroup(updated)))" />
            }
            <ConnectionLayer Wires="@wires" DraftPath="@DraftPath" OnSelect="SelectConnection" />
            @foreach (var wire in wires.Where(ShowBadge))
            {
                <ConnectionAmountBadge @key="wire.Id" Wire="@wire" Zoom="@Snapshot.Viewport.Zoom" OnSelect="SelectConnection"
                                       ShowAuthoredLabel="@Snapshot.ShowSecondaryAnnotations" />
            }
            @foreach (var note in Snapshot.Notes.Where(note => Snapshot.NoteDetail(note.Id) != AnnotationDetail.Hidden))
            {
                <NoteCard @key="note.Id" Note="@DisplayNote(note)" Selected="@(Snapshot.SelectedNoteId == note.Id)"
                          Locked="@(HasAnnotationDraft || AnnotationActionsDisabled)"
                          Detail="@Snapshot.NoteDetail(note.Id)" Zoom="@Snapshot.Viewport.Zoom" OnReveal="@(() => SelectAnnotationAsync(note.Id, false))"
                          OnMove="@(args => BeginNoteAsync(note, args, false))" OnResize="@(args => BeginNoteAsync(note, args, true))"
                          OnSelect="@(() => { State.SelectNote(note.Id); })" OnEdit="@(() => BeginNoteEditAsync(note.Id))"
                          OnUpdate="UpdateNote" OnDuplicate="@(() => NoteAction(() => State.DuplicateNote(note.Id)))"
                          OnDelete="@(() => NoteAction(() => State.DeleteNote(note.Id)))" />
            }
            @foreach (var node in Snapshot.Graph.Nodes.OrderBy(node => node.TypeKey is InputRack.NodeType or OutputRack.NodeType ? 1 : 0))
            {
                <NodeFrame @key="node.Id" Node="@node" Position="@DisplayNodePosition(node.Id)" PatchId="@PatchId" GraphId="@Snapshot.GraphId"
                           Documentation="@Snapshot.NodeDescriptions.GetValueOrDefault(node.Id)"
                           ShowSecondaryDocumentation="@(Snapshot.ShowSecondaryAnnotations || Snapshot.SelectedNodeIds.Contains(node.Id))"
                           OnEditDescription="@(() => EditNodeDescriptionAsync(node.Id))" DocumentationEditDisabled="@(HasAnnotationDraft || AnnotationActionsDisabled)"
                           Visualization="@Snapshot.VisualizationFor(node.Id)" VisualizationExpanded="@(Snapshot.ExpandedVisualizationNodeId == node.Id)"
                           OnVisualizationChange="@(settings => { State.SetVisualization(node.Id, settings); })"
                           OnExpandVisualization="@(() => { State.SetExpandedVisualization(Snapshot.ExpandedVisualizationNodeId == node.Id ? null : node.Id); })"
                           Role="@NodeRoleClassifier.Classify(Snapshot.Graph, node)"
                           Selected="@Snapshot.SelectedNodeIds.Contains(node.Id)" PendingSource="@pendingSource"
                           WireTargets="@(wireAim is not null ? wireTargetAddresses : null)"
                           OnHeaderPointerDown="@(args => BeginNode(node.Id, args))"
                           OnBodyPointerDown="BeginNodeSurfaceAsync"
                           OnOutputPointerDown="BeginOutput" OnInputPointerDown="BeginInputNavigationAsync" OnPortActivate="ActivatePortAsync"
                           OnOpenComposite="OnOpenComposite"
                           OnEditRack="OnEditRack"
                           OnAudition="OnAudition"
                           OnPresetApply="OnPresetApply" OnManagePresets="OnManagePresets" PresetCatalogRevision="@PresetCatalogRevision"
                           OnParameterEdit="OnParameterEdit" OnParameterGestureEnded="OnParameterGestureEnded" ModulationRanges="@ModulationRanges" EffectiveValues="@EffectiveValues" Playhead="@EnvelopePlayheads.GetValueOrDefault(node.Id)" BeatsPerMinute="@BeatsPerMinute" SampleRate="@SampleRate" />
            }
        </div>
        @if (wireAim is { } aim)
        {
            <div class="touch-wire-assist" aria-hidden="true">
                @foreach (var target in wireTargets)
                {
                    <span class="touch-wire-target @(target == aim.Target ? "is-snapped" : "")"
                          style="@WireTargetStyle(target.Point)"></span>
                }
                <span class="touch-wire-cursor" style="@WireTargetStyle(aim.Point)"></span>
            </div>
            @if (aim.Target is { } snapped)
            {
                <div class="touch-wire-label" role="status">@WireTargetLabel(snapped.Address)</div>
            }
        }
        @if (MarqueeStyle is { } marqueeStyle)
        {
            <div class="canvas-marquee" style="@marqueeStyle" aria-hidden="true"></div>
        }
        @if (Snapshot.Notes.FirstOrDefault(note => note.Id == editingNote) is { } editing)
        {
            <NoteEditor @key="editing.Id" Note="@editing" OnApply="FinishNoteEditAsync" OnCancel="@(() => FinishNoteEditAsync(null))" />
        }
        <div class="canvas-view-tools" data-mobile-sheet="view" @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true" @onwheel:stopPropagation="true">
        <MobileSheetHeader Title="View" OnClose="OnCloseMobileTools" />
        <div class="connection-label-control" @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true">
            <label for="connection-label-mode">Connection labels</label>
            <select id="connection-label-mode" @bind="LabelMode" aria-label="Connection labels">
                @foreach (var mode in Enum.GetValues<Orbit.Application.Persistence.ConnectionLabelMode>())
                {
                    <option value="@mode">@mode</option>
                }
            </select>
            <button type="button" class="secondary desktop-selection-trigger" aria-expanded="@selectionPanelOpen" aria-label="Selection actions"
                    @onclick="() => selectionPanelOpen = !selectionPanelOpen">@(marqueeMode ? "Selecting" : "Selection")</button>
            @if (selectionPanelOpen || MobileSelectionOpen)
            {
                <section class="canvas-selection-panel" data-mobile-sheet="selection" aria-label="Node selection" role="region" @onwheel:stopPropagation="true">
                    <MobileSheetHeader Title="Selection" OnClose="CloseSelectionAsync" />
                    <strong role="status">@SelectionSummary</strong>
                    <p class="workspace-notice">Rack and master nodes stay outside reusable modules. Boundary routing will be checked when grouping.</p>
                    <button type="button" class="secondary" aria-pressed="@marqueeMode" disabled="@AnnotationControlsLocked"
                            @onclick="ToggleMarqueeMode">@(marqueeMode ? "Return to pan" : "Marquee mode")</button>
                    <button type="button" class="secondary" disabled="@(AnnotationControlsLocked || !EligibleNodes.Any())" @onclick="SelectAllModuleNodes">Select all module nodes</button>
                    <button type="button" class="secondary" disabled="@AnnotationControlsLocked" @onclick="ClearModuleSelection">Clear selection</button>
                    <label for="selection-candidate">Individual module node</label>
                    <select id="selection-candidate" @bind="selectionCandidate" disabled="@AnnotationControlsLocked">
                        <option value="">Choose node</option>
                        @foreach (var node in EligibleNodes)
                        {
                            <option value="@node.Id">@(Snapshot.SelectedNodeIds.Contains(node.Id) ? "✓ " : "")@Snapshot.DisplayName(node.Id) · @node.Id.ToString("N")[..8]</option>
                        }
                    </select>
                    <button type="button" class="secondary" disabled="@(AnnotationControlsLocked || !CandidateExists)" @onclick="ToggleCandidate">Toggle node selection</button>
                    @if (SelectedVisualGroupMember)
                    {
                        <p class="workspace-notice">Remove selected nodes from their visual groups before creating a composite.</p>
                    }
                    @if (CanGroup)
                    {
                        var crossings = GroupCrossings;
                        <label for="composite-name">Composite name</label>
                        <input id="composite-name" maxlength="100" @bind="compositeName" @bind:event="oninput" />
                        <details>
                            <summary>Boundary preview: @crossings.Count(port => port.IsInput) inputs · @crossings.Count(port => !port.IsInput) outputs</summary>
                            @foreach (var crossing in crossings)
                            {
                                <p class="workspace-notice">@(crossing.IsInput ? "Input" : "Output") · @crossing.Name (@crossing.SignalType)</p>
                            }
                            <p class="workspace-notice">Existing amounts and connections are retained. Rename ports inside the composite.</p>
                        </details>
                        <button type="button" disabled="@string.IsNullOrWhiteSpace(compositeName)" @onclick="CreateCompositeAsync">Create composite</button>
                    }
                    @if (SelectedComposite is { } selectedComposite && OnUngroupComposite.HasDelegate)
                    {
                        <p class="workspace-notice">Expand @selectedComposite.Name one level using its current routing. Nested composites stay intact.</p>
                        <button type="button" class="secondary" disabled="@AnnotationControlsLocked" @onclick="UngroupCompositeAsync">Ungroup composite</button>
                    }
                    <button type="button" class="secondary" @onclick="CloseSelectionAsync">Close selection actions</button>
                </section>
            }
        </div>
        <div class="workspace-mobile-only workspace-view-summary">
            <p class="workspace-notice">Canvas: @Snapshot.Graph.Nodes.Count nodes · @Snapshot.Graph.Connections.Count connections</p>
            <p class="workspace-notice">Entire patch: @PatchCounts.Nodes nodes · @PatchCounts.Connections connections</p>
            <p class="workspace-notice">Drag the background to pan; pinch to zoom and pan with two fingers. Triple-tap empty canvas to fit. On desktop use the wheel and triple-click or F. Drag a cable and aim with the cursor above your finger. Edit → Selection actions enables marquee selection.</p>
        </div>
        <div class="annotation-display-control" @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true" @onwheel:stopPropagation="true">
            <label for="annotation-visibility">Annotations</label>
            <select id="annotation-visibility" @bind="VisibilityMode" disabled="@AnnotationControlsLocked">
                <option value="@Orbit.Application.Persistence.AnnotationVisibility.Show">Show</option>
                <option value="@Orbit.Application.Persistence.AnnotationVisibility.TitlesOnly">Titles only</option>
                <option value="@Orbit.Application.Persistence.AnnotationVisibility.Hide">Hide</option>
            </select>
            @if (HasAnnotations)
            {
                <button type="button" class="secondary" disabled="@AnnotationControlsLocked" aria-expanded="@finderOpen"
                        @onclick="ToggleFinder">Find annotation</button>
                <button type="button" class="secondary" disabled="@AnnotationControlsLocked" @onclick="FitSignalsAsync">Fit signals</button>
            }
            @if (finderOpen && HasAnnotations)
            {
                <div class="annotation-finder" role="region" aria-label="Find annotation">
                    <label for="annotation-target">Note or group</label>
                    <select id="annotation-target" @bind="finderTarget" disabled="@AnnotationControlsLocked">
                        <option value="">Select an annotation</option>
                        @foreach (var note in Snapshot.Notes.OrderBy(note => note.Title, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@($"note:{note.Id}")">Note: @note.Title</option>
                        }
                        @foreach (var group in Snapshot.VisualGroups.OrderBy(group => group.Title, StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@($"group:{group.Id}")">Group: @group.Title</option>
                        }
                    </select>
                    <button type="button" disabled="@(!FinderTargetExists || AnnotationControlsLocked)" @onclick="RevealAnnotationAsync">Reveal and fit</button>
                </div>
            }
        </div>
        @if (CanShowScope)
        {
            <button type="button" class="secondary canvas-scope-action" @onpointerdown:stopPropagation="true"
                    @onclick:stopPropagation="true" @onclick="OnToggleScope">@(ScopeOpen ? "Hide scope" : "Show scope")</button>
        }
        </div>
        <span class="canvas-count">@($"{Snapshot.Graph.Nodes.Count} nodes · {Snapshot.Graph.Connections.Count} connections{(Snapshot.Notes.Count > 0 ? $" · {Snapshot.Notes.Count} notes" : "")}")</span>
        <span class="canvas-patch-count">Entire patch: <span class="canvas-patch-value">@($"{PatchCounts.Nodes} nodes · {PatchCounts.Connections} connections")</span></span>
        @if (Hint is { } hint)
        {
            <span class="canvas-hint">@hint</span>
        }
        @if (Snapshot.SelectedConnectionIds.Count == 1 && wires.FirstOrDefault(wire => wire.Selected) is { } selectedWire)
        {
            <ConnectionAmountEditor @key="(Snapshot.GraphId, selectedWire.Id)" Graph="@Snapshot.Graph"
                                    Connection="@Snapshot.Graph.Connections.Single(edge => edge.Id == selectedWire.Id)"
                                    AuthoredLabel="@selectedWire.AuthoredLabel" OnEditDescription="EditSelectedDescriptionAsync"
                                    DescriptionEditDisabled="@(HasAnnotationDraft || AnnotationActionsDisabled)"
                                    Anchor="@Snapshot.Viewport.WorldToScreen(new CanvasPoint(selectedWire.BadgeX, selectedWire.BadgeY))"
                                    Dispatch="@DispatchConnectionAmount" OnCancel="CloseConnectionEditorAsync" />
        }
        @if (editingDescription is { } description)
        {
            <DescriptionEditor @key="description.Id" Heading="@description.Heading" IsConnection="@description.IsConnection"
                               InitialName="@description.Name" InitialBody="@description.Body"
                               OnApply="ApplyDescriptionAsync" OnCancel="CloseDescriptionAsync" />
        }
        @if (editingGroup is { } groupEdit)
        {
            <VisualGroupEditor @key="groupEdit.Id" Group="@groupEdit" Options="@GroupMemberOptions(groupEdit.Id)"
                               OnApply="FinishGroupEditAsync" OnCancel="@(() => FinishGroupEditAsync(null))" />
        }
        @if (Snapshot.Graph.Nodes.Count == 0 && !Snapshot.Notes.Any(note => Snapshot.NoteDetail(note.Id) != AnnotationDetail.Hidden)
            && !Snapshot.VisualGroups.Any(group => Snapshot.GroupDetail(group.Id) != AnnotationDetail.Hidden))
        {
            <div class="canvas-empty">Add a node to start building your graph.</div>
        }
        @if (contextMenu is { } menu)
        {
            <div class="canvas-context-overlay" @onpointerdown:stopPropagation="true" @onpointerup:stopPropagation="true"
                 @onpointermove:stopPropagation="true" @onwheel:stopPropagation="true"
                 @onkeydown="ContextKeyDown" @onkeydown:stopPropagation="true">
                <div class="canvas-context-backdrop" @onclick="CloseContextAsync" aria-hidden="true"></div>
                <section class="canvas-context-menu @(menu.Request.Touch ? "canvas-context-sheet" : "")" role="dialog" aria-label="@($"{menu.Title} actions")">
                    <header class="canvas-context-heading">
                        <strong>@menu.Title</strong>
                        <button type="button" class="secondary" aria-label="Close contextual actions" @onclick="CloseContextAsync">Close</button>
                    </header>
                    @foreach (var action in menu.Actions)
                    {
                        <button type="button" class="secondary @(action.Destructive ? "canvas-context-destructive" : "")"
                                @onclick="() => RunContextAsync(action)">@action.Label</button>
                    }
                </section>
            </div>
        }
    </div>
</div>
