@namespace Orbit.UI.Components.Canvas
@using Microsoft.AspNetCore.Components.Web
@using Orbit.Presentation.Canvas
@using Orbit.Domain.Nodes.Composites

@* Root and nested editors use the same canvas, with no dependencies on the DSP runtime. *@
@{ var wires = Wires; }
<div class="graph-canvas">
    <div class="canvas-viewport" @ref="viewportElement" tabindex="0" aria-label="Graph canvas"
         @onpointerdown="BeginBackground" @onpointerdown:preventDefault="true"
         @onpointermove="PointerMoved" @onpointerup="PointerReleasedAsync"
         @onpointercancel="CancelGesture" @onpointerleave="CancelGesture"
         @onwheel="OnWheelAsync" @onwheel:preventDefault="true" @onkeydown="KeyDown">
        <div class="canvas-world" style="@WorldStyle">
            <ConnectionLayer Wires="@wires" DraftPath="@DraftPath" OnSelect="SelectConnection" />
            @foreach (var wire in wires.Where(ShowBadge))
            {
                <ConnectionAmountBadge @key="wire.Id" Wire="@wire" Zoom="@Snapshot.Viewport.Zoom" OnSelect="SelectConnection" />
            }
            @foreach (var node in Snapshot.Graph.Nodes.OrderBy(node => node.TypeKey is InputRack.NodeType or OutputRack.NodeType ? 1 : 0))
            {
                <NodeFrame @key="node.Id" Node="@node" Position="@Snapshot.NodePositions[node.Id]" PatchId="@PatchId" GraphId="@Snapshot.GraphId"
                           Visualization="@Snapshot.VisualizationFor(node.Id)" VisualizationExpanded="@(Snapshot.ExpandedVisualizationNodeId == node.Id)"
                           OnVisualizationChange="@(settings => { State.SetVisualization(node.Id, settings); })"
                           OnExpandVisualization="@(() => { State.SetExpandedVisualization(Snapshot.ExpandedVisualizationNodeId == node.Id ? null : node.Id); })"
                           Role="@NodeRoleClassifier.Classify(Snapshot.Graph, node)"
                           Selected="@Snapshot.SelectedNodeIds.Contains(node.Id)" PendingSource="@pendingSource"
                           OnHeaderPointerDown="@(args => BeginNode(node.Id, args))"
                           OnOutputPointerDown="BeginOutput" OnPortActivate="ActivatePortAsync"
                           OnOpenComposite="OnOpenComposite"
                           OnEditRack="OnEditRack"
                           OnAudition="OnAudition"
                           OnPresetApply="OnPresetApply" OnManagePresets="OnManagePresets" PresetCatalogRevision="@PresetCatalogRevision"
                           OnParameterEdit="OnParameterEdit" OnParameterGestureEnded="OnParameterGestureEnded" ModulationRanges="@ModulationRanges" EffectiveValues="@EffectiveValues" Playhead="@EnvelopePlayheads.GetValueOrDefault(node.Id)" BeatsPerMinute="@BeatsPerMinute" SampleRate="@SampleRate" />
            }
        </div>
        <div class="connection-label-control" @onpointerdown:stopPropagation="true">
            <label for="connection-label-mode">Connection labels</label>
            <select id="connection-label-mode" @bind="LabelMode" aria-label="Connection labels">
                @foreach (var mode in Enum.GetValues<Orbit.Application.Persistence.ConnectionLabelMode>())
                {
                    <option value="@mode">@mode</option>
                }
            </select>
        </div>
        <span class="canvas-count">@($"{Snapshot.Graph.Nodes.Count} nodes · {Snapshot.Graph.Connections.Count} connections")</span>
        @if (CanShowScope)
        {
            <button type="button" class="secondary canvas-scope-action" @onpointerdown:stopPropagation="true"
                    @onclick:stopPropagation="true" @onclick="OnToggleScope">@(ScopeOpen ? "Hide scope" : "Show scope")</button>
        }
        <span class="canvas-hint">@Hint</span>
        @if (Snapshot.SelectedConnectionIds.Count == 1 && wires.FirstOrDefault(wire => wire.Selected) is { } selectedWire)
        {
            <ConnectionAmountEditor @key="(Snapshot.GraphId, selectedWire.Id)" Graph="@Snapshot.Graph"
                                    Connection="@Snapshot.Graph.Connections.Single(edge => edge.Id == selectedWire.Id)"
                                    Anchor="@Snapshot.Viewport.WorldToScreen(new CanvasPoint(selectedWire.BadgeX, selectedWire.BadgeY))"
                                    Dispatch="@DispatchConnectionAmount" OnCancel="CloseConnectionEditorAsync" />
        }
        @if (Snapshot.Graph.Nodes.Count == 0)
        {
            <div class="canvas-empty">Add a node to start building your graph.</div>
        }
    </div>
</div>
