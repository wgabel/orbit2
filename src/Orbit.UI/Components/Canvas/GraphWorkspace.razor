@namespace Orbit.UI.Components.Canvas
@using Microsoft.AspNetCore.Components.Web
@using Orbit.UI.Components.Analysis
@using Orbit.Domain.Nodes.Composites

@* One patch session and playback controller, with a reusable active canvas. *@
@if (!initialized)
{
    <p>Restoring workspace…</p>
}
else
{
    var graphId = Canvas.Snapshot.GraphId;
<section class="graph-workspace" data-active-graph="@graphId" data-mobile-panel="@mobilePanel" data-mobile-active-panel="@ActiveMobilePanel"
         data-mobile-panel-locked="@(overviewDraft || annotationDraft || switchingWorkspace ? "true" : "false")" @ref="workspaceElement">
    <header class="workspace-header">
        <h1>Orbit 2 <span class="workspace-build" title="@BrowserBuild.Description" aria-label="@BrowserBuild.Description"
                         data-build-commit="@BrowserBuild.Commit" data-build-number="@BrowserBuild.Number">@BrowserBuild.Label</span></h1>
        <CanvasBreadcrumbs Path="@Navigation.Path" OnNavigate="NavigateTo" />
        <PatchOutlinePanel @key="workspaceGeneration" Open="@outlineOpen" Locked="@(annotationDraft || switchingWorkspace)"
                           Outline="@(outlineOpen ? Navigation.GetOutline(overview.Title) : null)" OnClose="CloseOutline" OnNavigate="NavigateOutline" />

        <div class="workspace-toolbar toolbar-group workspace-edit-tools" data-mobile-sheet="edit" role="region" aria-label="Editing tools">
            <MobileSheetHeader Title="Edit" OnClose="DismissMobilePanelAsync" />
            <p class="workspace-notice workspace-selection-summary" role="status">@MobileSelectionSummary</p>
            <button type="button" class="secondary" disabled="@(annotationDraft || switchingWorkspace)" @onclick='() => ToggleMobilePanel("selection")'>Selection actions</button>
            <button type="button" class="secondary" disabled="@(!session.CanUndo || switchingWorkspace)" @onclick="Undo">Undo</button>
            <button type="button" class="secondary" disabled="@(!session.CanRedo || switchingWorkspace)" @onclick="Redo">Redo</button>
            <button type="button" class="secondary" disabled="@(!Canvas.Snapshot.CanUndoAnnotations || annotationDraft || switchingWorkspace)" @onclick="UndoAnnotation">Undo annotation</button>
            <button type="button" class="secondary" disabled="@(!Canvas.Snapshot.CanRedoAnnotations || annotationDraft || switchingWorkspace)" @onclick="RedoAnnotation">Redo annotation</button>
            <button type="button" class="secondary contextual-action" disabled="@(annotationDraft || switchingWorkspace || !CanDescribeSelection)"
                    @onclick="DescribeFromToolbarAsync">Describe selected</button>
            <button type="button" class="secondary" disabled="@(annotationDraft || switchingWorkspace)"
                    @onclick="GroupFromToolbarAsync">Create visual group</button>
            <button type="button" class="secondary contextual-action" disabled="@(!HasSelection || annotationDraft || switchingWorkspace)" @onclick="DeleteSelection">Delete selected</button>
        </div>
    </header>
    <nav class="mobile-workspace-bar" aria-label="Workspace tools">
        <button type="button" class="secondary" data-mobile-trigger="nodes" aria-expanded="@(mobilePanel == "nodes")" disabled="@(overviewDraft || annotationDraft || addingNode || switchingWorkspace)" @onclick='() => ToggleMobilePanel("nodes")'><WorkspaceToolIcon Tool="nodes" /> <span>Nodes</span></button>
        <button type="button" class="secondary" data-mobile-trigger="outline" aria-expanded="@outlineOpen" disabled="@overviewDraft" @onclick="ToggleMobileOutline"><WorkspaceToolIcon Tool="outline" /> <span>Outline</span></button>
        <button type="button" class="secondary" data-mobile-trigger="edit" aria-expanded="@(mobilePanel == "edit" || mobilePanel == "selection")" disabled="@overviewDraft" @onclick='() => ToggleMobilePanel("edit")'><WorkspaceToolIcon Tool="edit" /> <span>Edit</span></button>
        <button type="button" class="secondary" data-mobile-trigger="view" aria-expanded="@(mobilePanel == "view")" disabled="@overviewDraft" @onclick='() => ToggleMobilePanel("view")'><WorkspaceToolIcon Tool="view" /> <span>View</span></button>
        <button type="button" class="secondary" data-mobile-trigger="more" aria-expanded="@(mobilePanel == "more")" disabled="@overviewDraft" @onclick='() => ToggleMobilePanel("more")'><WorkspaceToolIcon Tool="more" /> <span>More</span></button>
    </nav>
    <div class="canvas-caption">
        <div class="workspace-toolbar toolbar-group workspace-nodes-tools" data-mobile-sheet="nodes" role="region" aria-label="Add nodes">
        <NodeLibrary Open="@NodeLibraryOpen" Entries="@LibraryEntries" KnownKeys="@LibraryKeys" Disabled="@(addingNode || switchingWorkspace || annotationDraft)"
                     OnAdd="@AddNodeFromLibraryAsync" OnClose="CloseNodeLibrary" />
        </div>
        <GraphPlaybackControls @key="workspaceGeneration" @ref="playbackControls" Snapshot="@session.Snapshot" TelemetryChanged="OnTelemetryChanged" TempoChanged="OnTempoChanged" SampleRateChanged="OnSampleRateChanged" PlaybackStopped="ResetPerformance" Disabled="switchingWorkspace"
                               MobileTransportOpen="@(mobilePanel == "transport")" OnMobileTempo="@(() => ToggleMobilePanel("transport"))" MobileToolsLocked="@overviewDraft" />
        <div class="workspace-more-tools" data-mobile-sheet="more" role="region" aria-label="More tools">
            <MobileSheetHeader Title="More" Locked="@overviewDraft" OnClose="DismissMobilePanelAsync" />
            <PatchManager @ref="patchManager" Capture="CaptureCommittedWorkspace" OpenDocument="ReplaceWorkspaceAsync" NewDocument="NewWorkspaceAsync"
                          Overview="@overview" OverviewEditDisabled="@(annotationDraft || switchingWorkspace)"
                          OnOverviewDraftChanged="SetOverviewDraftAsync" OnOverviewApplied="ApplyOverview" />
            <PerformanceMonitor @ref="performanceMonitor" PatchId="@session.GraphId" EditableCounts="@Navigation.PatchCounts" />
        </div>
    </div>
    @if (Error is not null)
    {
        <p class="parameter-error workspace-error" role="alert">@Error</p>
    }
    @if (PersistenceError is not null)
    {
        <p class="parameter-error workspace-error" role="alert">@PersistenceError</p>
    }
    @if (PresetLibraryError is not null)
    {
        <p class="parameter-error workspace-error" role="alert">@PresetLibraryError</p>
    }
    @if (ManagingPresetNode is { } presetNode)
    {
        <NodePresetManager @key="(graphId, presetNode.Id)" Node="@presetNode" OnClose="ClosePresetManager" OnLibraryChanged="OnPresetLibraryChanged" />
    }
    @if (EditingRack is { } rack)
    {
        <RackPortEditor @key="(graphId, rack.Id)" GraphId="@graphId" Rack="@rack"
                        Dispatch="@DispatchRackCommand" OnClose="CloseRackEditor" />
    }
    @if (macroDraft is { } draft)
    {
        <CompositeMacroEditor @key="draft" Draft="@draft" CurrentRevision="@session.Snapshot.Revision"
                              Dispatch="ApplyMacroDraft" OnCancel="CloseMacroEditor" />
    }
    <GraphCanvas @key="(workspaceGeneration, graphId)" @ref="canvasView" State="@Canvas" PatchId="@session.GraphId" AutoFitOnFirstRender="@Navigation.IsFirstVisit"
                 OutlineFocus="@outlineFocus"
                 PatchCounts="@Navigation.PatchCounts"
                 DispatchConnectionAmount="@DispatchConnectionCommand"
                 AnnotationActionsDisabled="@(switchingWorkspace || overviewDraft)" OnAnnotationDraftChanged="OnAnnotationDraftChanged" OnAnnotationError="@(value => Error = value)"
                 CanShowScope="@(ScopeSelection is not null || ScopeOpen)" ScopeOpen="@ScopeOpen" OnToggleScope="ToggleScopeFromToolbar"
                 MobileSelectionOpen="@(mobilePanel == "selection")" OnMobileToolCompleted="CompleteMobileCanvasTool" OnCloseMobileTools="DismissMobilePanelAsync"
                 OnConnect="@(request => Connect(graphId, request))" OnParameterEdit="@(request => EditParameter(graphId, request))" OnMacroEdit="@(request => EditMacro(graphId, request))"
                 OnParameterGestureEnded="@(id => CompleteParameterGesture(graphId, id))"
                 OnCancelParameterGesture="@(() => CancelCanvasParameterGesture(graphId))"
                 OnAudition="@(request => SetNodeAudition(graphId, request))"
                 OnPresetApply="@(request => ApplyNodePreset(graphId, request))"
                 OnManagePresets="@(nodeId => OpenPresetManagerAsync(graphId, nodeId))" PresetCatalogRevision="@PresetCatalog.Revision"
                 OnOpenComposite="@(nodeId => OpenComposite(graphId, nodeId))" OnEditMacros="@(nodeId => OpenMacroEditor(graphId, nodeId))"
                 OnGroupNodes="GroupNodes"
                 OnUngroupComposite="UngroupComposite"
                 OnEditRack="@(nodeId => OpenRackEditor(graphId, nodeId))"
                 OnContextAddNode="OpenContextLibrary" OnContextSelection="OpenContextSelection"
                 OnContextDelete="DeleteSelection" OnContextDuplicate="@(nodeId => DuplicateNode(graphId, nodeId))" OnContextUndo="Undo" OnContextRedo="Redo"
                 ContextCanUndo="@session.CanUndo" ContextCanRedo="@session.CanRedo"
                 ModulationRanges="@ModulationRanges" EffectiveValues="@CanvasEffectiveValues" EnvelopePlayheads="@CanvasEnvelopePlayheads" BeatsPerMinute="@tempo" SampleRate="@responseSampleRate" />
    @if (performanceAddress is { } address && PerformanceTarget is { } target)
    {
        <PerformanceKeyboard @key="(workspaceGeneration, address.GraphId, target.Id, performanceEpoch)" Node="@target" TargetGraph="@session.Snapshot.GetGraph(address.GraphId)" TargetLabel="@(performanceLabel ?? target.Name)" PatchId="@session.GraphId" GraphId="@address.GraphId" Offset="@PerformanceOffset(address.GraphId, target.Id)" Playhead="@PerformanceStep(address.GraphId, target.Id)" Tempo="@tempo" Edit="@(request => EditPerformanceParameter(address.GraphId, target.Id, request))" ClearPattern="@(() => ClearPitchPattern(address.GraphId, target.Id))" CommitTake="@(take => CommitPitchTake(address.GraphId, target.Id, take))" Humanize="@((first, count, profile) => HumanizePitchPattern(address.GraphId, target.Id, first, count, profile))" />
    }
    @if (ScopeNode is { } scopeNode)
    {
        <NodeVisualizationPanel @key="(workspaceGeneration, graphId, scopeNode.Id)" PatchId="@session.GraphId"
                          GraphId="@graphId" Node="@scopeNode" Expanded="true" Settings="@Canvas.Snapshot.VisualizationFor(scopeNode.Id)"
                          BeatsPerMinute="@tempo" SampleRate="@responseSampleRate" ModulationRanges="@ModulationRanges" EffectiveValues="@EffectiveValues" Playhead="@EnvelopePlayheads.GetValueOrDefault(scopeNode.Id)"
                          SettingsChanged="@(settings => UpdateScopeSettings(graphId, scopeNode.Id, settings))" OnExpand="CloseScope" />
    }
</section>
}
