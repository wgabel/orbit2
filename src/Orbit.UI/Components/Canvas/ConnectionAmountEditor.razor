@namespace Orbit.UI.Components.Canvas
@using Orbit.UI.Components.Parameters
@using Microsoft.AspNetCore.Components.Web

@* Edit a selected route without changing its topology. Apply explicitly so
   typing intermediate values does not repeatedly compile new audio programs. *@
<section @ref="root" class="connection-amount-editor" aria-label="Connection amount editor"
         data-anchor-x="@Anchor.X.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         data-anchor-y="@Anchor.Y.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         @onpointerdown:stopPropagation="true" @onclick:stopPropagation="true"
         @onwheel:stopPropagation="true" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation="true">
    <strong>@RouteName</strong>
    @if (AuthoredLabel.Length > 0)
    {
        <p class="connection-authored-label">@AuthoredLabel</p>
    }
    <button type="button" class="secondary" disabled="@DescriptionEditDisabled" @onclick="OnEditDescription">Edit connection label</button>
    @if (IsEvent)
    {
        <p class="workspace-notice">Rhythmic event · unity connection. No amount control.</p>
        <button type="button" class="secondary" @onclick="OnCancel">Close</button>
    }
    else
    {
    <div class="workspace-toolbar">
        <label for="@InputId">@AmountLabel (@UnitLabel)</label>
        <input id="@InputId" type="number" step="any" value="@Draft" @oninput="EditDraft"
               aria-invalid="@(Error is not null ? "true" : "false")" aria-describedby="@ErrorId" />
        <button type="button" @onclick="Apply">Apply amount</button>
        <button type="button" class="secondary" @onclick="OnCancel">Cancel</button>
    </div>
    <ValidationMessage Message="@Error" MessageId="@ErrorId" />
    <p class="workspace-notice">@Explanation</p>
    }
</section>
