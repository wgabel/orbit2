@namespace Orbit.UI.Components.Canvas
@using Microsoft.AspNetCore.Components.Web

@* A wide transparent hit path and a visible Bézier path share identical geometry. *@
<g class="@WireClass">
    <path class="connection-hit" d="@Wire.Path" @onpointerdown="Select" @onpointerdown:stopPropagation="true" />
    <path class="connection-line" d="@Wire.Path" />
</g>
