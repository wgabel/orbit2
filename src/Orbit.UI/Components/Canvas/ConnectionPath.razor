@namespace Orbit.UI.Components.Canvas
@using Microsoft.AspNetCore.Components.Web

@* A wide transparent hit path and the colored cable share identical geometry. Rigid sleeves overlay the same cable color. *@
<g class="@WireClass">
    @if (Wire.Dormant)
    {
        <title>Inactive in current mode; connection retained</title>
    }
    <path class="connection-hit" data-connection-id="@Wire.Id" d="@Wire.Path" role="button" tabindex="0"
          aria-label="@($"Select connection: {Wire.Description}")" aria-pressed="@(Wire.Selected ? "true" : "false")"
          @onpointerdown="Select" @onpointerdown:stopPropagation="true"
          @onclick="SelectClick" @onclick:stopPropagation="true" @onkeydown="SelectKey" />
    <path class="connection-line" d="@Wire.Path" />
    <path class="connection-line connection-rigid" d="@Wire.RigidPath" />
</g>
