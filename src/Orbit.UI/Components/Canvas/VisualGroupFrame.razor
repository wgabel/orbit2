@namespace Orbit.UI.Components.Canvas
@using Orbit.Application.Persistence
@using Microsoft.AspNetCore.Components.Web
@using Orbit.Presentation.Canvas

<div class="visual-group note-@Group.Accent.ToString().ToLowerInvariant() @(Selected ? "visual-group-selected" : "")"
     data-group-id="@Group.Id" style="@Style" aria-label="@($"Visual group: {Group.Title}")" @onfocusin="FocusFrame">
    @if (Detail is AnnotationDetail.Titles or AnnotationDetail.Marker)
    {
        <AnnotationMarker Title="@Group.Title" Kind="group" Accent="@Group.Accent" Zoom="@Zoom" WorldWidth="@Group.Width"
                          Detail="@Detail" Locked="@Locked" OnReveal="@OnReveal" />
    }
    else
    {
    <header class="visual-group-header" @onpointerdown="OnMove" @onpointerdown:stopPropagation="true"
            @onpointerdown:preventDefault="@(!Locked)">
        <span class="visual-group-title" title="@($"{Group.Title}\n{Group.Description}")">@Group.Title</span>
        <span class="visual-group-count">@MemberCount @(MemberCount == 1 ? "member" : "members")</span>
        <div class="note-actions" @onpointerdown:stopPropagation="true">
            <button type="button" disabled="@Locked" @onclick="OnEdit" aria-label="Edit visual group">Edit</button>
            <button type="button" disabled="@Locked" @onclick="OnDelete" aria-label="Delete visual group">Delete</button>
        </div>
    </header>
    <button class="visual-group-resize" type="button" disabled="@Locked" aria-label="Resize visual group"
            title="Drag to resize; arrow keys to resize" @onpointerdown="OnResize" @onpointerdown:stopPropagation="true"
            @onpointerdown:preventDefault="true" @onkeydown="ResizeKey" @onkeydown:stopPropagation="true">↘</button>
    }
</div>

@code {
    private int MemberCount => Group.NodeIds.Count + Group.NoteIds.Count;
    [Parameter, EditorRequired] public SavedVisualGroup Group { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Locked { get; set; }
    [Parameter] public AnnotationDetail Detail { get; set; } = AnnotationDetail.Full;
    [Parameter] public double Zoom { get; set; } = 1;
    [Parameter] public EventCallback OnReveal { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    private Task FocusFrame() => Detail != AnnotationDetail.Full || Locked ? Task.CompletedTask : OnSelect.InvokeAsync();
    [Parameter] public EventCallback<PointerEventArgs> OnMove { get; set; }
    [Parameter] public EventCallback<PointerEventArgs> OnResize { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback<SavedVisualGroup> OnUpdate { get; set; }
    private string Style => FormattableString.Invariant($"left:{Group.X}px;top:{Group.Y}px;width:{Group.Width}px;height:{Group.Height}px");
    private Task ResizeKey(KeyboardEventArgs args)
    {
        var width = Group.Width + (args.Key == "ArrowRight" ? 16 : args.Key == "ArrowLeft" ? -16 : 0);
        var height = Group.Height + (args.Key == "ArrowDown" ? 16 : args.Key == "ArrowUp" ? -16 : 0);
        return Locked || (width == Group.Width && height == Group.Height) ? Task.CompletedTask :
            OnUpdate.InvokeAsync(Group with { Width = Math.Clamp(width, SavedVisualGroup.MinWidth, SavedVisualGroup.MaxSize),
                Height = Math.Clamp(height, SavedVisualGroup.MinHeight, SavedVisualGroup.MaxSize) });
    }
}
