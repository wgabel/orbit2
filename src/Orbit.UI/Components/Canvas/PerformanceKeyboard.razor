@namespace Orbit.UI.Components.Canvas
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Orbit.Application.Graphs.Snapshots
@using Orbit.Application.Models
@using Orbit.Application.Services
@using Orbit.Domain.Nodes.Generators
@using Orbit.Domain.Timing
@using Orbit.Presentation.Canvas
@using Orbit.Domain.Parameters
@using System.Globalization
@implements IAsyncDisposable
@inject IPerformanceNoteService Performance
@inject IMusicalTransportService Transport
@inject IJSRuntime JavaScript

<section class="performance-keyboard" aria-label="Performance keyboard" data-target-node="@Node.Id" data-target-graph="@GraphId" data-armed="@armed.ToString().ToLowerInvariant()" data-tall="@tall.ToString().ToLowerInvariant()" data-step-entry="@((stepEntry && showPattern).ToString().ToLowerInvariant())" data-keyboard-ready="@((adapter is not null).ToString().ToLowerInvariant())" tabindex="0" @ref="root">
    <div class="performance-dock-bar">
        <div class="performance-target" title="@($"{TargetLabel ?? Node.Name} · {Node.Name}")">
            <span class="performance-target-name"><span class="performance-target-dot" data-live="@((Offset is not null).ToString().ToLowerInvariant())" aria-hidden="true"></span>@(TargetLabel ?? Node.Name)</span>
            <small>Octave @octave · reference @MusicalPitch.NoteName(Reference)</small>
        </div>
        <output class="performance-live-pitch" data-live-pitch-offset="@(Offset?.ToString(CultureInfo.InvariantCulture) ?? "unavailable")" aria-label="Live pitch offset" title="Measured pitch offset (semitones)">
            @(Offset is double offset ? $"{offset:+0.##;-0.##;0} st" : "—")
        </output>
        @if (armed)
        {
            <button type="button" class="secondary performance-tool" aria-label="Octave − (Z)" title="Octave down (Z)" disabled="@(!PerformanceKeyboardLayout.IsAvailable(octave - 1, Reference))" @onclick="() => ChangeOctave(-1)">−</button>
            <button type="button" class="secondary performance-tool" aria-label="Octave + (X)" title="Octave up (X)" disabled="@(!PerformanceKeyboardLayout.IsAvailable(octave + 1, Reference))" @onclick="() => ChangeOctave(1)">+</button>
            <button type="button" class="secondary performance-tool" aria-label="@(IsNoteSource ? "Release all notes" : "Reset pitch")" title="@(IsNoteSource ? "Release all notes" : "Reset pitch")" @onclick="ResetAsync">■</button>
            @if (!IsNoteSource)
            {
                <button type="button" class="secondary performance-tool" disabled="@RecordingLocked" @onclick="() => showPattern = !showPattern" aria-label="@(showPattern ? "Hide pattern" : "Edit pattern")" title="Pitch pattern" aria-expanded="@showPattern.ToString().ToLowerInvariant()">▤</button>
            }
            <button type="button" class="secondary performance-tool" aria-label="@(tall ? "Compact keyboard" : "Expand keyboard")" title="Change keyboard height" aria-pressed="@tall.ToString().ToLowerInvariant()" @onclick="() => tall = !tall">↕</button>
        }
        <button type="button" class="secondary performance-tool" aria-label="@(armed ? "Collapse keyboard" : "Show keyboard")" title="@(armed ? "Collapse keyboard" : "Show keyboard")" aria-expanded="@armed.ToString().ToLowerInvariant()" @onclick="ToggleAsync">@(armed ? "⌄" : "⌃")</button>
    </div>
    @if (armed && !IsNoteSource && showPattern)
    {
        <div class="pitch-pattern-editor" role="region" aria-label="Pitch pattern">
            <div class="workspace-toolbar pitch-pattern-settings">
                @foreach (var definition in NoteSequencerGenerator.PatternDefinitions.Take(7).Where(d => VisibleSetting(d.Key)))
                {
                    <label @key="definition.Key">@definition.Name
                        @if (definition.Choices is { } choices)
                        {
                            <select disabled="@RecordingLocked" aria-label="@definition.Name" value="@Format(Value(definition.Key))" @onchange="e => EditValueAsync(definition.Key, e)">
                                @foreach (var choice in choices)
                                {
                                    <option value="@Format(choice.Value)">@choice.Label</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input disabled="@RecordingLocked" type="number" aria-label="@definition.Name" min="@Format(definition.Minimum)" max="@Format(definition.Maximum)" step="0.01" value="@Format(Value(definition.Key))" @onchange="e => EditValueAsync(definition.Key, e)" />
                        }
                    </label>
                }
                <output data-sequence-playhead="@(Playhead?.ToString() ?? "none")">@(Playhead is int step ? $"Playing step {step}" : "No active step") · @LoopDuration</output>
            </div>
            <div class="pitch-pattern-grid" role="group" aria-label="Pattern steps">
                @for (var index = 0; index < StepCount; index++)
                {
                    var slot = index;
                    var code = take?.Step(slot) ?? (int)Value(NoteSequencerGenerator.StepKey(slot));
                    <button type="button" class="secondary @(Playhead == slot + 1 ? "pitch-step-playing" : "")" aria-pressed="@((selectedStep == slot).ToString().ToLowerInvariant())" data-step="@(slot + 1)" aria-label="@($"Step {slot + 1}: {StepLabel(code)}")" @onclick="() => selectedStep = slot">
                        <small>@(slot + 1)</small><span>@StepLabel(code)</span>
                    </button>
                }
            </div>
            <div class="workspace-toolbar">
                <label>Selected step @(selectedStep + 1)
                    <select disabled="@RecordingLocked" aria-label="Step note" value="@Format(take?.Step(selectedStep) ?? Value(NoteSequencerGenerator.StepKey(selectedStep)))" @onchange="e => EditValueAsync(NoteSequencerGenerator.StepKey(selectedStep), e)">
                        <option value="0">Hold</option>
                        @foreach (var note in Enumerable.Range(0, 128))
                        {
                            <option value="@(note + 1)">@MusicalPitch.NoteName(note)</option>
                        }
                    </select>
                </label>
                <button type="button" class="secondary" disabled="@RecordingLocked" @onclick="() => WriteStepAsync(0, false)">Clear step (Hold)</button>
                <button type="button" class="secondary" disabled="@RecordingLocked" @onclick="ClearAllAsync">@(confirmClear ? "Confirm clear all 64 slots" : "Clear all")</button>
                @if (confirmClear) { <button type="button" class="secondary" @onclick="() => confirmClear = false">Cancel</button> }
                <label><input type="checkbox" disabled="@RecordingLocked" @bind="stepEntry" /> Step entry (arm keyboard)</label>
                <label>Advance <select disabled="@RecordingLocked" aria-label="Auto advance" @bind="advance">@foreach (var n in new[] { 1, 2, 4, 8 }) { <option value="@n">@n</option> }</select></label>
                <small>Space = Hold, arrows = select step. Step entry wraps; shrinking retains hidden slots.</small>
            </div>
            <div class="workspace-toolbar" role="group" aria-label="Live recording" data-recording="@((take is not null).ToString().ToLowerInvariant())">
                <label>Take mode <select aria-label="Take mode" disabled="@RecordingLocked" @bind="takeMode"><option value="0">Overdub</option><option value="1">Replace active slots</option></select></label>
                <label>Quantize <select aria-label="Recording quantization" disabled="@RecordingLocked" @bind="quantizeSpacing">
                    @foreach (var spacing in Enumerable.Range(1, StepCount).Where(n => StepCount % n == 0))
                    {
                        <option value="@spacing">Every @spacing @(spacing == 1 ? "step" : "steps")</option>
                    }
                </select></label>
                @if (take is null)
                {
                    <button type="button" class="secondary" disabled="@(!CanStartTake || recordingOperation)" @onclick="StartTakeAsync">Record take</button>
                }
                else
                {
                    <button type="button" class="secondary" disabled="@(recordingOperation || pendingNotes > 0)" @onclick="CommitTakeAsync">Commit take</button>
                    <button type="button" class="secondary" @onclick="CancelTake">Cancel take</button>
                    <output data-recorded-slots="@take.RecordedSlots">@take.RecordedSlots recorded slots · pending take</output>
                }
                <small>Arm keyboard and play a connected Loop. Notes sound immediately; the pending grid is saved only on Commit. Replace clears active slots, not hidden slots.</small>
                @if (recordingNotice is not null) { <span class="workspace-notice" role="status">@recordingNotice</span> }
            </div>
        </div>
    }
    @if (armed)
    {
        <div class="performance-piano" role="group" aria-label="On-screen piano">
            @foreach (var pianoKey in PerformanceKeyboardLayout.PianoKeys)
            {
                var note = PerformanceKeyboardLayout.Note(octave, pianoKey);
                var label = note <= 127 ? MusicalPitch.NoteName(note) : "—";
                var caption = pianoKey.Hint is { } hint ? $"Play {label} ({hint})" : $"Play {label}";
                <button @key="pianoKey.Semitone" type="button" class="@($"performance-key {(pianoKey.Black ? "performance-black-key" : "performance-white-key")}{(pianoKey.Extension ? " performance-extension" : "")}")"
                        style="@($"grid-column: {pianoKey.GridColumn} / span 2")" data-midi-note="@note" aria-label="@caption"
                        data-held="@((held.ContainsValue(note)).ToString().ToLowerInvariant())"
                        disabled="@(!NoteSequencerGenerator.IsPlayable(note, Reference))" @onclick="e => ClickNoteAsync(note, e)">
                    <span>@label</span>@if (pianoKey.Hint is not null) { <small>@pianoKey.Hint</small> }
                </button>
            }
        </div>
        @if (notice is not null) { <span class="performance-dock-notice workspace-notice" role="status">@notice</span> }
    }
</section>

@code {
    [Parameter, EditorRequired] public GraphNodeSnapshot Node { get; set; } = default!;
    [Parameter] public string? TargetLabel { get; set; }
    [Parameter] public Guid PatchId { get; set; }
    [Parameter] public Guid GraphId { get; set; }
    [Parameter] public double? Offset { get; set; }
    [Parameter] public int? Playhead { get; set; }
    [Parameter] public double Tempo { get; set; }
    [Parameter] public EventCallback<ParameterEditRequest> Edit { get; set; }
    [Parameter] public EventCallback ClearPattern { get; set; }
    [Parameter, EditorRequired] public Func<PitchRecordingTake, bool> CommitTake { get; set; } = default!;
    private ElementReference root;
    private IJSObjectReference? module, adapter;
    private DotNetObjectReference<PerformanceKeyboard>? reference;
    private Task? mounting;
    private bool disposed, focusRequested;
    private bool armed = true, tall;
    private bool showPattern, stepEntry, confirmClear;
    private int selectedStep, advance = 1;
    private int octave = 4;
    private int previousReference = -1;
    private string? notice;
    private string? recordingNotice;
    private PitchRecordingTake? take;
    private bool recordingOperation;
    private int takeMode, quantizeSpacing = 1, pendingNotes;
    private bool RecordingLocked => take is not null || recordingOperation;
    private bool IsNoteSource => Node.TypeKey == NoteSourceGenerator.NodeType;
    private double KeyboardVelocity => IsNoteSource ? Value(NoteSourceGenerator.VelocityKey) : 1;
    private bool CanStartTake => armed && !stepEntry && Offset is not null && Value(NoteSequencerGenerator.LoopKey) == 1;
    private readonly Dictionary<string, int> held = [];
    private int Reference => (int)Node.Parameters.Single(p => p.Definition.Key == NoteSequencerGenerator.ReferenceKey).BaseValue;
    private double Value(string key) => Node.Parameters.Single(p => p.Definition.Key == key).BaseValue;
    private int StepCount => (int)Value(NoteSequencerGenerator.CountKey);
    private bool Free => Value(NoteSequencerGenerator.TimingKey) == 1;
    private string LoopDuration => Free
        ? $"Loop: {Value(NoteSequencerGenerator.SecondsKey) * StepCount:0.##} s"
        : $"Loop: {Value(NoteSequencerGenerator.DivisionKey) * Value(NoteSequencerGenerator.MultiplierKey) * StepCount / 4:0.##} beats · {Value(NoteSequencerGenerator.DivisionKey) * Value(NoteSequencerGenerator.MultiplierKey) * StepCount / 4 * 60 / Tempo:0.##} s";
    private bool VisibleSetting(string key) => key switch { NoteSequencerGenerator.SecondsKey => Free, NoteSequencerGenerator.DivisionKey or NoteSequencerGenerator.MultiplierKey => !Free, _ => true };
    private static string Format(double value) => value.ToString(CultureInfo.InvariantCulture);
    private static string StepLabel(int code) => code == 0 ? "Hold" : MusicalPitch.NoteName(code - 1);
    private async Task EditValueAsync(string key, ChangeEventArgs args)
    {
        if (RecordingLocked) return;
        var p = Node.Parameters.Single(p => p.Definition.Key == key);
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) && p.Definition.IsValidBaseValue(value))
            await Edit.InvokeAsync(new(new ParameterAddress(Node.Id, p.Id), value));
    }
    private async Task WriteStepAsync(int code, bool move)
    {
        if (RecordingLocked) return;
        var p = Node.Parameters.Single(p => p.Definition.Key == NoteSequencerGenerator.StepKey(selectedStep));
        await Edit.InvokeAsync(new(new ParameterAddress(Node.Id, p.Id), code));
        if (move) selectedStep = (selectedStep + advance) % StepCount;
    }
    private async Task EnterNoteAsync(int note)
    {
        if (recordingOperation) return;
        if (stepEntry && showPattern) { await WriteStepAsync(note + 1, true); return; }
        var current = take;
        if (current is null) { await SendAsync(new(PerformanceNoteKind.NoteOn, note, KeyboardVelocity)); return; }
        pendingNotes++;
        try
        {
            // Sample the real transport at input admission, not the displayed playhead.
            var position = await Transport.ReadPlayingPositionAsync();
            if (disposed || !ReferenceEquals(take, current)) return;
            if (position is null || !current.IsCurrent(position)) { CancelTake("Take cancelled: transport changed."); return; }
            if (await SendAsync(new(PerformanceNoteKind.NoteOn, note)) && !disposed && ReferenceEquals(take, current))
                current.TryRecord(note, position);
        }
        catch (Exception exception) { recordingNotice = $"Recording unavailable: {exception.Message}"; }
        finally { pendingNotes--; if (!disposed) StateHasChanged(); }
    }

    private async Task StartTakeAsync()
    {
        if (!CanStartTake || RecordingLocked) return;
        recordingOperation = true;
        var baseline = PitchPattern.FromNode(Node);
        var referenceNote = Reference;
        try
        {
            var position = await Transport.ReadPlayingPositionAsync();
            if (disposed || !CanStartTake || !baseline.Matches(PitchPattern.FromNode(Node)) || referenceNote != Reference) return;
            if (position is null) { recordingNotice = "Start playback before recording."; return; }
            take = new PitchRecordingTake(baseline, referenceNote, quantizeSpacing, takeMode == 1, position);
            recordingNotice = null;
            confirmClear = false;
            focusRequested = true;
        }
        catch (Exception exception) { recordingNotice = exception.Message; }
        finally { recordingOperation = false; }
    }

    private async Task CommitTakeAsync()
    {
        if (take is not { } current || pendingNotes > 0 || recordingOperation) return;
        recordingOperation = true;
        try
        {
            var position = await Transport.ReadPlayingPositionAsync();
            if (disposed || !ReferenceEquals(take, current)) return;
            if (position is null || !current.IsCurrent(position)) { CancelTake("Take cancelled: transport changed."); return; }
            // Clear draft before the synchronous graph command publishes its new snapshot.
            take = null;
            recordingNotice = CommitTake(current) ? "Take committed." : "Take not committed: pattern changed.";
        }
        catch (Exception exception) { recordingNotice = exception.Message; }
        finally { recordingOperation = false; }
    }

    private void CancelTake() => CancelTake("Take cancelled; committed pattern unchanged.");
    private void CancelTake(string message) { take = null; recordingNotice = message; }
    private async Task ClearAllAsync()
    {
        if (RecordingLocked) return;
        if (!confirmClear) { confirmClear = true; return; }
        confirmClear = false;
        await ClearPattern.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        if (previousReference < 0 || !PerformanceKeyboardLayout.IsAvailable(octave, Reference)) octave = PerformanceKeyboardLayout.ReferenceOctave(Reference);
        previousReference = Reference;
        if (IsNoteSource) return;
        selectedStep = Math.Clamp(selectedStep, 0, StepCount - 1);
        if (StepCount % quantizeSpacing != 0) quantizeSpacing = 1;
        if (take is { } current && !current.MatchesSource(PitchPattern.FromNode(Node), Reference))
            CancelTake("Take cancelled: pattern or reference changed.");
    }

    private async Task ToggleAsync()
    {
        armed = !armed;
        if (!armed)
        {
            if (take is not null) CancelTake();
            showPattern = false;
            held.Clear();
            if (adapter is not null) await adapter.InvokeVoidAsync("clear");
            if (IsNoteSource) await ReleaseAllAsync();
        }
        else focusRequested = true;
        notice = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await (mounting = MountAsync());
        if (focusRequested && armed && !disposed && adapter is not null)
        {
            focusRequested = false;
            await adapter.InvokeVoidAsync("focus");
        }
    }

    private async Task MountAsync()
    {
        try
        {
            module = await JavaScript.InvokeAsync<IJSObjectReference>("import", BrowserBuild.ModulePath("performanceKeyboard.js"));
            if (disposed) return;
            reference = DotNetObjectReference.Create(this);
            adapter = await module.InvokeAsync<IJSObjectReference>("mountPerformanceKeyboard", root, reference, PerformanceKeyboardLayout.Keys.Select(key => key.Code).ToArray());
            if (!disposed) StateHasChanged();
        }
        catch (JSException) { notice = "Keyboard capture unavailable; click for a short strike."; if (!disposed) StateHasChanged(); }
    }

    private void ChangeOctave(int delta)
    {
        if (PerformanceKeyboardLayout.IsAvailable(octave + delta, Reference)) octave += delta;
    }

    [JSInvokable] public Task PhysicalKey(string code, bool down) => InvokeAsync(async () =>
    {
        if (!armed || disposed) return;
        if (!down)
        {
            if (held.Remove(code, out var released) && !held.ContainsValue(released)) await SendAsync(new(PerformanceNoteKind.NoteOff, released));
            StateHasChanged();
            return;
        }
        if (stepEntry && showPattern && code is "Space" or "ArrowLeft" or "ArrowRight")
        {
            if (code == "Space") await WriteStepAsync(0, true);
            else selectedStep = (selectedStep + (code == "ArrowLeft" ? StepCount - 1 : 1)) % StepCount;
            StateHasChanged(); return;
        }
        if (code is "KeyZ" or "KeyX") { ChangeOctave(code == "KeyZ" ? -1 : 1); StateHasChanged(); return; }
        var key = PerformanceKeyboardLayout.Keys.SingleOrDefault(key => key.Code == code);
        if (key is null || held.ContainsKey(code)) return;
        var note = PerformanceKeyboardLayout.Note(octave, key);
        if (!NoteSequencerGenerator.IsPlayable(note, Reference)) return;
        var alreadyHeld = held.ContainsValue(note);
        held.Add(code, note);
        if (!IsNoteSource || !alreadyHeld) await EnterNoteAsync(note);
        StateHasChanged();
    });

    [JSInvokable] public Task ReleasePhysicalKeys() => InvokeAsync(async () =>
    {
        held.Clear();
        if (IsNoteSource && !disposed) await ReleaseAllAsync();
        if (!disposed) StateHasChanged();
    });

    // The DOM adapter captures the pointer and hit-tests the piano during slides.
    // Musical identity/held-key priority stays here, not in JavaScript.
    [JSInvokable] public Task PianoPointer(long pointerId, int? note) => InvokeAsync(async () =>
    {
        if (!armed || disposed) return;
        var code = $"pointer-{pointerId}";
        var previous = held.Remove(code, out var old) ? (int?)old : null;
        if (note is int next && NoteSequencerGenerator.IsPlayable(next, Reference))
        {
            var alreadyHeld = held.ContainsValue(next);
            held[code] = next;
            // Retune first, then release the previous key, for continuous legato.
            if (previous != next && (!IsNoteSource || !alreadyHeld)) await EnterNoteAsync(next);
        }
        if (IsNoteSource && previous is int released && released != note && !held.ContainsValue(released))
            await SendAsync(new(PerformanceNoteKind.NoteOff, released));
        StateHasChanged();
    });

    private async Task ClickNoteAsync(int note, MouseEventArgs e)
    {
        if (!armed || (adapter is not null && e.Detail != 0) || held.ContainsValue(note)) return;
        // Native keyboard/screen-reader activation is a short strike.
        if (!IsNoteSource) { await EnterNoteAsync(note); return; }
        if (await SendAsync(new(PerformanceNoteKind.NoteOn, note, KeyboardVelocity)))
            await SendAsync(new(PerformanceNoteKind.NoteOff, note));
    }

    private async Task ResetAsync()
    {
        held.Clear();
        if (adapter is not null) await adapter.InvokeVoidAsync("clear");
        await SendAsync(new(PerformanceNoteKind.Reset));
    }
    private async Task ReleaseAllAsync()
    {
        try { await Performance.SendAsync(PatchId, GraphId, Node.Id, new(PerformanceNoteKind.Reset)); }
        catch (Exception) { /* Runtime may already have been disposed. */ }
    }
    private async Task<bool> SendAsync(PerformanceNoteAction action)
    {
        if (!armed || disposed) return false;
        var accepted = false;
        try { accepted = await Performance.SendAsync(PatchId, GraphId, Node.Id, action); notice = accepted ? null : "Play a connected patch; retry if updating or busy."; }
        catch (Exception exception) { notice = $"Performance unavailable: {exception.Message}"; }
        if (!disposed) StateHasChanged();
        return accepted;
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        held.Clear();
        if (IsNoteSource) await ReleaseAllAsync();
        if (mounting is not null) await mounting;
        try { if (adapter is not null) { await adapter.InvokeVoidAsync("dispose"); await adapter.DisposeAsync(); } }
        finally { reference?.Dispose(); if (module is not null) await module.DisposeAsync(); }
    }
}
