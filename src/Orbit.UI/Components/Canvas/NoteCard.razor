@namespace Orbit.UI.Components.Canvas
@using Orbit.Application.Persistence
@using Microsoft.AspNetCore.Components.Web

<article class="note-card note-@Note.Accent.ToString().ToLowerInvariant() @(Selected ? "note-selected" : "")"
         data-note-id="@Note.Id" style="@Style" aria-label="@($"Note: {Note.Title}")"
         @onpointerdown:stopPropagation="true" @onkeydown:stopPropagation="true"
         @onwheel:stopPropagation="true">
    <header class="note-header" @onpointerdown="OnMove" @onpointerdown:preventDefault="@(!Locked)">
        <span class="note-title" title="@Note.Title">@Note.Title</span>
        <div class="note-actions" @onpointerdown:stopPropagation="true">
            <button type="button" disabled="@Locked" title="Edit note" @onclick="OnEdit">Edit</button>
            <button type="button" disabled="@Locked" title="@(Note.Collapsed ? "Expand note" : "Collapse note")"
                    @onclick="() => OnUpdate.InvokeAsync(Note with { Collapsed = !Note.Collapsed })">@(Note.Collapsed ? "+" : "−")</button>
        </div>
    </header>
    @if (!Note.Collapsed)
    {
        <div class="note-body" tabindex="0" @onclick="OnSelect">@Note.Body</div>
        <footer class="note-footer">
            <span>@Note.Accent</span>
            <div class="note-actions">
                <button type="button" disabled="@Locked" @onclick="OnDuplicate">Duplicate</button>
                <button type="button" disabled="@Locked" @onclick="OnDelete">Delete</button>
                <button type="button" class="note-resize" disabled="@Locked" aria-label="Resize note" title="Drag to resize; arrow keys to resize"
                        @onpointerdown="OnResize" @onpointerdown:preventDefault="true" @onkeydown="ResizeKey">↘</button>
            </div>
        </footer>
    }
</article>

@code {
    [Parameter, EditorRequired] public SavedNote Note { get; set; } = default!;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Locked { get; set; }
    [Parameter] public EventCallback<PointerEventArgs> OnMove { get; set; }
    [Parameter] public EventCallback<PointerEventArgs> OnResize { get; set; }
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback<SavedNote> OnUpdate { get; set; }
    [Parameter] public EventCallback OnDuplicate { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    private string Style => FormattableString.Invariant($"left:{Note.X}px;top:{Note.Y}px;width:{Note.Width}px;height:{(Note.Collapsed ? SavedNote.CollapsedHeight : Note.Height)}px");
    private Task ResizeKey(KeyboardEventArgs args)
    {
        var width = Note.Width + (args.Key == "ArrowRight" ? 16 : args.Key == "ArrowLeft" ? -16 : 0);
        var height = Note.Height + (args.Key == "ArrowDown" ? 16 : args.Key == "ArrowUp" ? -16 : 0);
        return Locked || (width == Note.Width && height == Note.Height) ? Task.CompletedTask :
            OnUpdate.InvokeAsync(Note with { Width = Math.Clamp(width, SavedNote.MinWidth, SavedNote.MaxSize), Height = Math.Clamp(height, SavedNote.MinHeight, SavedNote.MaxSize) });
    }
}
