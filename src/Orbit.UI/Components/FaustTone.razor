@namespace Orbit.UI.Components
@using Microsoft.AspNetCore.Components.Web

@* Presentation only: the code-behind calls IAudioService. The sound itself
   is generated by Sine.dsp, not by Blazor or this Razor component. *@
<section class="audio-experiment">
    <p class="eyebrow">Experiment 02 / Faust</p>
    <button type="button" @onclick="PlayToneAsync" disabled="@(!IsReady || IsPlaying)">
        @(IsPlaying ? "Playing…" : "Play Faust tone")
    </button>
    @if (!IsReady && ErrorMessage is null)
    {
        <p role="status">Loading audio engine…</p>
    }
    @if (ErrorMessage is not null)
    {
        <p role="alert">@ErrorMessage</p>
    }
</section>
