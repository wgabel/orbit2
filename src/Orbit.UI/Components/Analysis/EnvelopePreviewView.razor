@namespace Orbit.UI.Components.Analysis
@using System.Globalization
@using Orbit.Application.Graphs.Snapshots
@using Orbit.Application.Models
@using Orbit.Presentation.Canvas

<div class="processor-response envelope-preview @(Compact ? "scope-compact" : "")" data-configured-mode="envelope" data-envelope-mode="@preview.Mode">
    <div class="response-chart" role="img" aria-label="Configured envelope level from zero to one with proportional timed segments">
        <div class="response-db-axis" aria-hidden="true">
            <span style="top:0%">1</span>
            <span style="top:50%">0.5</span>
            <span style="top:100%">0</span>
        </div>
        <div class="response-plot-area">
            <svg class="response-plot" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <line class="response-grid" x1="0" x2="100" y1="50" y2="50" />
                @foreach (var segment in preview.Segments)
                {
                    @if (segment.Stage == EnvelopeStage.Hold)
                    {
                        <rect class="envelope-hold" x="@Number(segment.Start * 100)" y="0" width="@Number((segment.End - segment.Start) * 100)" height="100" />
                    }
                    <line class="response-grid" x1="@Number(segment.Start * 100)" x2="@Number(segment.Start * 100)" y1="0" y2="100" />
                }
                <polyline class="response-configured" points="@path" />
                @if (preview.PlayheadPosition(Playhead) is double position)
                {
                    <line class="envelope-playhead response-effective" x1="@Number(position * 100)" x2="@Number(position * 100)" y1="0" y2="100" />
                }
            </svg>
            <div class="envelope-time-axis"><span>0 ms</span><span>@Number(preview.TimedMilliseconds) ms@(preview.HasHold ? " + hold" : "")</span></div>
        </div>
    </div>
    <div class="envelope-segments">
        @foreach (var segment in preview.Segments)
        {
            <span data-envelope-stage="@segment.Stage" class="@(Playhead?.Stage == segment.Stage ? "envelope-stage-active" : null)">
                @segment.Stage · @(segment.Milliseconds is double ms ? $"{Number(ms)} ms" : "until gate closes")
            </span>
        }
    </div>
    <small class="response-notice">Configured · from rest@(preview.HasHold ? " · hold width illustrative" : "")</small>
    <small class="response-notice" data-envelope-playhead="@(Playhead?.Stage.ToString() ?? "unavailable")">
        @(Playhead is null ? "Live stage unavailable" : Playhead.Stage is EnvelopeStage.Idle or EnvelopeStage.Hold ? $"Live · {Playhead.Stage}" : $"Live · {Playhead.Stage} {Playhead.Progress:P0}")
        @if (Node.IsMuted) { <span> · muted output</span> }
    </small>
</div>

@code {
    [Parameter, EditorRequired] public GraphNodeSnapshot Node { get; set; } = default!;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public EnvelopePlayhead? Playhead { get; set; }
    private EnvelopePreview preview = default!;
    private string path = "";
    private GraphNodeSnapshot? previousNode;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(previousNode, Node)) return;
        previousNode = Node;
        preview = EnvelopePreview.Create(Node);
        path = string.Join(" ", preview.Points.Select(point => $"{Number(point.X * 100)},{Number((1 - point.Level) * 100)}"));
    }

    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
}
