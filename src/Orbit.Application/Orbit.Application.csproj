<!-- A plain .NET class library. It has no dependency on Blazor, the browser,
     or Orbit.UI, so application services can be reused independently. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Application services create and edit the platform-neutral domain model. -->
    <ProjectReference Include="../Orbit.Domain/Orbit.Domain.csproj" />
  </ItemGroup>
</Project>
